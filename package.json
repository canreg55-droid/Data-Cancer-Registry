{
  "name": "sijill-cancer-registry",
  "productName": "Sijill Cancer Registry",
  "version": "1.0.0",
  "description": "Local bilingual-name cancer registry data extraction and review application",
  "author": "Sijill Cancer Registry",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/copy-ocr-models.js",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/copy-ocr-models.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "app:dev": "npm run build && electron .",
    "app:pack:win": "npm run build && electron-builder --win --dir",
    "app:installer:win": "npm run build && electron-builder --win nsis",
    "test": "node --test"
  },
  "build": {
    "appId": "org.sijill.cancerregistry",
    "productName": "Sijill Cancer Registry",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
